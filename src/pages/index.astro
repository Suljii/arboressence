---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { villes, metiers, contact } from '../data/seo.js';

const services = [
  {
    icon: "🌿",
    title: "Aménagement paysager",
    desc: "Conception et réalisation de jardins, massifs, allées et engazonnement. Chaque espace est pensé sur-mesure selon vos envies et votre budget.",
    href: "/services/amenagement",
    label: "Découvrir →",
  },
  {
    icon: "🌳",
    title: "Élagage & Abattage",
    desc: "Taille, réduction de couronne, abattage d'arbres dangereux et rognage de souches. Nous intervenons en toute sécurité.",
    href: "/services/elagage",
    label: "Découvrir →",
  },
  {
    icon: "✂️",
    title: "Entretien espaces verts",
    desc: "Tonte, taille d'arbustes, désherbage et soins saisonniers. Un entretien régulier de votre jardin, au fil des saisons.",
    href: "/services/entretien",
    label: "Découvrir →",
  },
  {
    icon: "💧",
    title: "Arrosage automatique",
    desc: "Installation et maintenance de systèmes d'arrosage intelligents. Un arrosage précis, adapté aux besoins de votre jardin.",
    href: "/services/arrosage",
    label: "Découvrir →",
  },
  {
    icon: "🏠",
    title: "Service à la personne",
    desc: "Bénéficiez d'une réduction d'impôts de 50% sur l'entretien de votre jardin grâce au dispositif Services à la Personne.",
    href: "/services/service-personne",
    label: "Découvrir →",
  },
];

const stats = [
  { value: "+20", label: "ans d'expérience" },
  { value: "Devis", label: "gratuit et sans engagement" },
  { value: "Île-de-France", label: "zone d'intervention" },
  { value: "Éco", label: "responsable" },
];

const clients = [
  { icon: "🏡", label: "Particuliers" },
  { icon: "🏢", label: "Copropriétés" },
  { icon: "🏘️", label: "Résidences" },
];

const temoignages = [
  {
    text: "Travail soigné, équipe sérieuse et ponctuelle. Notre jardin a été entièrement repensé, le résultat dépasse nos attentes.",
    name: "Marie L.",
    ville: "Maisons-Alfort",
    note: "⭐⭐⭐⭐⭐",
  },
  {
    text: "Très professionnel pour l'entretien de notre résidence. Toujours présents au bon moment, espaces verts impeccables.",
    name: "Syndic Résidence les Acacias",
    ville: "Créteil",
    note: "⭐⭐⭐⭐⭐",
  },
  {
    text: "Arrosage automatique installé rapidement et proprement. Parfait suivi, je recommande vivement.",
    name: "Thomas B.",
    ville: "Vincennes",
    note: "⭐⭐⭐⭐⭐",
  },
];
---

<Layout title="Arbor'essence | Paysagiste Val-de-Marne & Île-de-France">
  <Header />

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-overlay"></div>
      <div class="hero-pattern"></div>
    </div>
    <div class="container hero-content">
      <p class="tag hero-tag">Paysagiste depuis plus de 20 ans</p>
      <h1>
        Des jardins<br/>
        <em>et des arbres.</em>
      </h1>
      <p class="hero-desc">
        Arbor'essence crée, entretient et sublime vos espaces verts à L'Haÿ-les-Roses et en Île-de-France. Du jardin privé à la résidence, nous donnons vie à vos projets avec soin et expertise.
      </p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Devis gratuit</a>
        <a href="#services" class="btn btn-outline-light">Nos services</a>
      </div>
      <div class="hero-stats">
        {stats.map(s => (
          <div class="stat">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="hero-scroll">
      <span>↓</span>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section class="intro">
    <div class="container intro-inner">
      <div class="intro-text reveal">
        <p class="tag">Notre philosophie</p>
        <h2>Un jardin pensé pour durer, conçu pour vous.</h2>
        <p>Chez Arbor'essence, nous croyons que chaque espace extérieur mérite une attention particulière. Fort d'une expérience de plus de 20 ans en Île-de-France, nous accompagnons particuliers, résidences et copropriétés dans tous leurs projets paysagers, du premier coup de crayon à l'entretien au fil des saisons.</p>
        <a href="/about" class="btn btn-outline" style="margin-top:1.5rem;">À propos de nous →</a>
      </div>
      <div class="intro-pillars reveal">
        <div class="pillar">
          <span class="pillar-icon">🌱</span>
          <strong>Savoir-faire reconnu</strong>
          <p>Une petite équipe de paysagistes et d'élagueurs, à votre écoute.</p>
        </div>
        <div class="pillar">
          <span class="pillar-icon">♻️</span>
          <strong>Éco-responsable</strong>
          <p>Matériel électrique, gestion raisonnée de l'eau, respect de la biodiversité.</p>
        </div>
        <div class="pillar">
          <span class="pillar-icon">📍</span>
          <strong>Ancrage local</strong>
          <p>Implantés dans le Val-de-Marne, nous connaissons parfaitement le 94 et l'IDF.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section class="services" id="services">
    <div class="container">
      <div class="section-head reveal">
        <p class="tag">Ce que nous faisons</p>
        <h2>Nos métiers du paysage</h2>
        <p class="section-sub">De la conception à l'entretien, nous maîtrisons chaque étape de la vie de votre jardin.</p>
      </div>
      <div class="services-grid">
        {services.map((s, i) => (
          <a href={s.href} class={`service-card reveal ${i === 0 ? 'service-card--featured' : ''}`} style={`transition-delay: ${i * 0.08}s`}>
            <span class="service-icon">{s.icon}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="service-link">{s.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CLIENTS ===== -->
  <section class="clients-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="tag">Nos clients</p>
        <h2>Nous intervenons pour</h2>
      </div>
      <div class="clients-grid">
        {clients.map(c => (
          <div class="client-card reveal">
            <span class="client-icon">{c.icon}</span>
            <strong>{c.label}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA BANDE ===== -->
  <section class="cta-band">
    <div class="container cta-inner reveal">
      <div>
        <h2>Un projet en tête ?</h2>
        <p>Contactez-nous pour un devis gratuit et sans engagement. Nous vous répondons rapidement.</p>
      </div>
      <div class="cta-actions">
        <a href="/contact" class="btn btn-primary">Demander un devis</a>
        <a href={`tel:${contact.telRaw}`} class="btn btn-outline-light">{contact.tel}</a>
      </div>
    </div>
  </section>

  <!-- ===== AVIS ===== -->
  <section class="avis-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="tag">Témoignages</p>
        <h2>Ce que disent nos clients</h2>
      </div>
      <div class="avis-grid">
        {temoignages.map(t => (
          <div class="avis-card reveal">
            <p class="avis-note">{t.note}</p>
            <p class="avis-text">"{t.text}"</p>
            <div class="avis-author">
              <strong>{t.name}</strong>
              <span>{t.ville}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== SERVICE À LA PERSONNE ===== -->
  <section class="sap-section">
    <div class="container sap-inner reveal">
      <div class="sap-badge">50%</div>
      <div class="sap-text">
        <p class="tag">Avantage fiscal</p>
        <h2>Réduction d'impôts sur l'entretien de votre jardin</h2>
        <p>En tant que prestataire déclaré Service à la Personne, Arbor'essence vous permet de bénéficier d'un crédit d'impôt de 50% sur les prestations d'entretien de jardin pour les particuliers.</p>
        <a href="/services/service-personne" class="btn btn-primary" style="margin-top:1.5rem;">En savoir plus</a>
      </div>
    </div>
  </section>

  <!-- ===== NOS PRESTATIONS ===== -->
  <section class="metiers-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="tag">Toutes nos prestations</p>
        <h2>Ce que nous faisons</h2>
        <p class="section-sub">Du simple entretien à la création complète de jardin, découvrez toutes nos interventions.</p>
      </div>
      <div class="metiers-grid">
        {metiers.map((m, i) => (
          <a href={`/metiers/${m.slug}`} class="metier-card reveal" style={`transition-delay:${i*0.05}s`}>
            <span class="mc-icon">{m.icon}</span>
            <h3>{m.titre}</h3>
            <p>{m.intro.substring(0, 75)}…</p>
            <span class="mc-link">En savoir plus →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== ZONES D'INTERVENTION ===== -->
  <section class="zones-section">
    <div class="container">
      <div class="section-head reveal">
        <p class="tag">Couverture locale</p>
        <h2>Nos zones d'intervention dans le 94</h2>
        <p class="section-sub">Arbor'essence intervient dans toutes les communes du Val-de-Marne. Cliquez sur votre ville pour découvrir nos services près de chez vous.</p>
      </div>
      <div class="villes-flex reveal">
        {villes.map(v => (
          <a href={`/villes/${v.slug}`} class="ville-badge">
            📍 {v.nom}
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(30,58,30,0.96) 0%, rgba(46,88,39,0.88) 50%, rgba(74,124,63,0.82) 100%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(122,158,114,0.12) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(242,234,216,0.06) 0%, transparent 40%);
  }

  /* Decorative leaves */
  .hero-bg::before {
    content: '❧';
    position: absolute;
    right: 8%;
    top: 50%;
    transform: translateY(-50%);
    font-size: clamp(8rem, 20vw, 22rem);
    color: rgba(255,255,255,0.035);
    line-height: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 5rem;
    padding-bottom: 5rem;
    animation: fadeUp 0.9s ease both;
  }

  .hero-tag { color: rgba(242,234,216,0.7); }

  .hero h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    color: var(--beige);
    margin-bottom: 1.5rem;
    max-width: 16ch;
  }
  .hero h1 em { font-style: italic; color: rgba(242,234,216,0.75); }

  .hero-desc {
    max-width: 52ch;
    color: rgba(242,234,216,0.8);
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3.5rem; }

  .btn-outline-light {
    background: transparent;
    color: var(--beige);
    border: 1.5px solid rgba(242,234,216,0.5);
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .9rem 2rem;
    font-family: var(--font-body);
    font-size: .85rem;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .3s;
  }
  .btn-outline-light:hover { background: rgba(242,234,216,0.1); border-color: var(--beige); }

  .hero-stats {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(242,234,216,0.15);
  }
  .stat { display: flex; flex-direction: column; }
  .stat strong { font-family: var(--font-display); font-size: 1.8rem; font-weight: 600; color: var(--beige); }
  .stat span { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(242,234,216,0.55); margin-top: 0.2rem; }

  .hero-scroll {
    position: absolute;
    bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    color: rgba(242,234,216,0.4);
    font-size: 1.2rem;
    animation: bounce 2s infinite;
    z-index: 2;
  }
  @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }

  /* ===== INTRO ===== */
  .intro { padding: var(--section-py) 0; background: var(--beige-clair); }
  .intro-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .intro-text h2 { font-size: clamp(1.8rem, 3vw, 2.5rem); margin-bottom: 1.25rem; color: var(--vert-fonce); }
  .intro-text p { line-height: 1.8; color: var(--texte-leger); font-size: 0.95rem; }

  .intro-pillars {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    align-items: start;
    padding: 1.5rem;
    background: var(--blanc);
    border-left: 3px solid var(--vert-sauge);
    box-shadow: 0 2px 16px rgba(30,58,30,0.05);
  }
  .pillar-icon { grid-row: 1/3; font-size: 1.6rem; padding-top: 0.1rem; }
  .pillar strong { font-weight: 500; color: var(--vert-fonce); font-size: 0.95rem; margin-bottom: 0.3rem; }
  .pillar p { font-size: 0.85rem; color: var(--texte-leger); line-height: 1.6; }

  /* ===== SERVICES ===== */
  .services { padding: var(--section-py) 0; background: var(--beige); }
  .section-head { margin-bottom: 3rem; }
  .section-head h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); color: var(--vert-fonce); margin-bottom: 0.75rem; }
  .section-sub { color: var(--texte-leger); font-size: 0.95rem; max-width: 55ch; }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .service-card {
    background: var(--blanc);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.3s ease;
    border-bottom: 3px solid transparent;
    box-shadow: 0 2px 12px rgba(30,58,30,0.06);
  }
  .service-card:hover {
    transform: translateY(-4px);
    border-bottom-color: var(--vert-moyen);
    box-shadow: 0 8px 30px rgba(30,58,30,0.12);
  }
  .service-card--featured {
    background: var(--vert-fonce);
    color: var(--beige);
  }
  .service-card--featured h3 { color: var(--beige); }
  .service-card--featured p { color: rgba(242,234,216,0.75); }
  .service-card--featured .service-link { color: var(--vert-sauge); }
  .service-card--featured:hover { border-bottom-color: var(--vert-sauge); }

  .service-icon { font-size: 1.8rem; }
  .service-card h3 { font-family: var(--font-display); font-size: 1.25rem; color: var(--vert-fonce); }
  .service-card p { font-size: 0.87rem; line-height: 1.7; color: var(--texte-leger); flex: 1; }
  .service-link { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.05em; color: var(--vert-moyen); margin-top: auto; }

  /* ===== CLIENTS ===== */
  .clients-section { padding: var(--section-py) 0; background: var(--beige-clair); }
  .clients-grid { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: 2rem; }
  .client-card {
    flex: 1;
    min-width: 200px;
    padding: 2.5rem 2rem;
    background: var(--blanc);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    box-shadow: 0 2px 16px rgba(30,58,30,0.06);
    transition: transform 0.3s;
  }
  .client-card:hover { transform: translateY(-4px); }
  .client-icon { font-size: 2.5rem; }
  .client-card strong { font-family: var(--font-display); font-size: 1.2rem; color: var(--vert-fonce); }

  /* ===== CTA BAND ===== */
  .cta-band {
    background: var(--vert-moyen);
    padding: clamp(3rem, 5vw, 4rem) 0;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .cta-band h2 { font-size: clamp(1.5rem, 3vw, 2rem); color: var(--beige); margin-bottom: 0.5rem; }
  .cta-band p { color: rgba(242,234,216,0.75); font-size: 0.95rem; }
  .cta-actions { display: flex; gap: 1rem; flex-wrap: wrap; flex-shrink: 0; }

  /* ===== AVIS ===== */
  .avis-section { padding: var(--section-py) 0; background: var(--beige); }
  .avis-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 0.5rem; }
  .avis-card {
    background: var(--blanc);
    padding: 2rem;
    box-shadow: 0 2px 16px rgba(30,58,30,0.06);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .avis-note { font-size: 0.9rem; }
  .avis-text { font-family: var(--font-display); font-size: 1.05rem; font-style: italic; color: var(--texte); line-height: 1.6; flex: 1; }
  .avis-author { border-top: 1px solid rgba(30,58,30,0.08); padding-top: 1rem; }
  .avis-author strong { display: block; font-size: 0.88rem; color: var(--vert-fonce); font-weight: 500; }
  .avis-author span { font-size: 0.78rem; color: var(--texte-leger); }

  /* ===== SAP ===== */
  .sap-section { padding: var(--section-py) 0; background: var(--beige-clair); }
  .sap-inner {
    display: flex;
    align-items: center;
    gap: 4rem;
    background: var(--vert-fonce);
    padding: 4rem;
    flex-wrap: wrap;
  }
  .sap-badge {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 600;
    color: var(--beige);
    opacity: 0.9;
    flex-shrink: 0;
    line-height: 1;
  }
  .sap-text { flex: 1; min-width: 280px; }
  .sap-text .tag { color: var(--vert-sauge); }
  .sap-text h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); color: var(--beige); margin-bottom: 1rem; }
  .sap-text p { color: rgba(242,234,216,0.75); font-size: 0.92rem; line-height: 1.75; }

  /* Nos prestations */
  .metiers-section { padding: var(--section-py) 0; background: var(--beige); }
  .section-head { margin-bottom: 2.5rem; }
  .section-head h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); color: var(--vert-fonce); margin-bottom: 0.5rem; }
  .section-sub { font-size: 0.92rem; color: var(--texte-leger); max-width: 55ch; }
  .metiers-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
  }
  .metier-card {
    background: var(--blanc);
    padding: 1.5rem;
    box-shadow: 0 2px 12px rgba(30,58,30,0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform 0.3s;
  }
  .metier-card:hover { transform: translateY(-4px); }
  .mc-icon { font-size: 1.75rem; }
  .metier-card h3 { font-family: var(--font-display); font-size: 1rem; color: var(--vert-fonce); line-height: 1.2; }
  .metier-card p { font-size: 0.8rem; color: var(--texte-leger); line-height: 1.55; flex: 1; }
  .mc-link { font-size: 0.75rem; font-weight: 500; color: var(--vert-moyen); margin-top: 0.25rem; }

  /* Zones */
  .zones-section { padding: var(--section-py) 0; background: var(--beige-clair); }
  .villes-flex {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .ville-badge {
    padding: 0.6rem 1.2rem;
    background: var(--blanc);
    border: 1.5px solid rgba(30,58,30,0.1);
    font-size: 0.87rem;
    color: var(--vert-fonce);
    transition: all 0.2s;
  }
  .ville-badge:hover {
    background: var(--vert-moyen);
    color: var(--beige);
    border-color: transparent;
  }

  /* Responsive */
  @media (max-width: 1100px) { .metiers-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) {
    .intro-inner { grid-template-columns: 1fr; gap: 3rem; }
    .services-grid { grid-template-columns: 1fr 1fr; }
    .avis-grid { grid-template-columns: 1fr 1fr; }
    .hero-stats { gap: 2rem; }
    .metiers-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
    .avis-grid { grid-template-columns: 1fr; }
    .sap-inner { padding: 2.5rem 1.5rem; gap: 2rem; }
    .hero-stats { gap: 1.5rem; }
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .metiers-grid { grid-template-columns: 1fr; }
  }
</style>
