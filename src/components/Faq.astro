---
// Questions fréquentes + balisage FAQPage
interface Props {
  titre: string;
  items: { q: string; r: string }[];
}
const { titre, items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map(({ q, r }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: r },
  })),
};
---

{items.length > 0 && (
  <section class="faq-section">
    <div class="container faq-inner reveal">
      <p class="tag">Questions fréquentes</p>
      <h2>{titre}</h2>
      <div class="faq-list">
        {items.map(({ q, r }) => (
          <details>
            <summary>{q}</summary>
            <p>{r}</p>
          </details>
        ))}
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}

<style>
  .faq-section { padding: var(--section-py) 0; background: var(--beige-clair); }
  .faq-inner { max-width: 820px; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); color: var(--vert-fonce); margin-bottom: 1.75rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  details { background: var(--blanc); box-shadow: 0 1px 8px rgba(30,58,30,0.06); }
  summary {
    cursor: pointer;
    list-style: none;
    padding: 1.1rem 3rem 1.1rem 1.25rem;
    position: relative;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--vert-fonce);
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+';
    position: absolute; right: 1.25rem; top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem; color: var(--vert-moyen);
    transition: transform 0.2s;
  }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  details p {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9rem; line-height: 1.8;
    color: var(--texte-leger);
  }
</style>
